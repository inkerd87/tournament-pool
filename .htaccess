# Enable PHP execution on Sprinthost
AddHandler application/x-httpd-php .php
AddType application/x-httpd-php .php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Direct access to notification scripts
    RewriteCond %{REQUEST_URI} ^/payanyway-notification\.php [NC]
    RewriteRule ^ - [L]

    # Don't rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else to index.html for React SPA
    RewriteRule ^ index.html [L]
</IfModule>
