# Скопируйте в .env.local и заполните значения:
#   cp .env.example .env.local

# Т-Банк интернет-эквайринг (СБП)
# Личный кабинет: https://business.tbank.ru → Приём оплаты → Терминалы
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# Публичный URL приложения (для SuccessURL и webhook).
# Локально: http://localhost:3000
# Прод: https://your-domain.ru
APP_URL=http://localhost:3000

# Секрет для JWT-сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=

# Пароль для /admin (данные матча: Room ID и пароль)
ADMIN_PASSWORD=admin
