# Скопируйте в .env.local и заполните значения:
#   cp .env.example .env.local

# ЮKassa — https://yookassa.ru/my/merchant/integration/api-keys
# Для тестов включите «Тестовый магазин» в личном кабинете.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичный URL приложения (для return_url и webhook).
# Локально: http://localhost:3000
# Прод: https://your-domain.ru
APP_URL=http://localhost:3000

# Секрет для JWT-сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=
