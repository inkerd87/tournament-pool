# Скопируйте в .env.local и заполните значения:
#   cp .env.example .env.local

# Robokassa
# Личный кабинет: https://partner.robokassa.ru
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# 1 — тестовый режим, 0 или пусто — боевой
ROBOKASSA_IS_TEST=1

# Публичный URL приложения (для SuccessURL и Result URL).
# Локально: http://localhost:3000
# Прод: https://your-domain.ru
APP_URL=http://localhost:3000

# Секрет для JWT-сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=

# Пароль для /admin (данные матча: Room ID и пароль)
ADMIN_PASSWORD=admin
