DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # Disable cache for HTML, PHP, and JSON so visitors always see fresh site & updates immediately
    <FilesMatch "\.(html|php|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Long cache for hashed static assets (Vite produces content hashes in filenames)
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Fast storage API routing
    RewriteRule ^api/storage/([a-zA-Z0-9_-]+)/?$ api/storage.php?key=$1 [QSA,L]
    RewriteRule ^api/storage/?$ api/storage.php [QSA,L]

    # Direct access to notification & payment scripts
    RewriteCond %{REQUEST_URI} ^/freekassa-notification\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/freekassa-create\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/freekassa-result\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/yookassa-notification\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/yookassa-create\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/payanyway-notification\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/p2p-webhook\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/api/storage\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # Don't rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else to index.html for React SPA
    RewriteRule ^ index.html [L]
</IfModule>
