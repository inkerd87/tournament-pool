DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Direct access to notification & payment scripts
    RewriteCond %{REQUEST_URI} ^/freekassa-notification\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/freekassa-create\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/freekassa-result\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/yookassa-notification\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/yookassa-create\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/payanyway-notification\.php [NC]
    RewriteRule ^ - [L]

    # Don't rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else to index.html for React SPA
    RewriteRule ^ index.html [L]
</IfModule>
